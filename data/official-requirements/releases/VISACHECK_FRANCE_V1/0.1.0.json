        },
        {
          "key": "SCHENGEN_SHORT_STAY_VISA_REQUIREMENT_BASELINE",
          "role": "baseline",
          "id": "SCHENGEN_SHORT_STAY_VISA_REQUIREMENT_BASELINE",
          "revision": "0.1.0",
          "path": "data/official-requirements/rules/SCHENGEN_SHORT_STAY_VISA_REQUIREMENT_BASELINE/0.1.0.json"
