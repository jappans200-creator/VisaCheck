  "report": {
    "document_attention_ids": [
      "SCHENGEN_INSURANCE_EVIDENCE",
      "SCHENGEN_ACCOMMODATION_EVIDENCE",
      "SCHENGEN_FINANCIAL_EVIDENCE",
      "SCHENGEN_RETURN_FUNDS_EVIDENCE",
      "SCHENGEN_RETURN_ONWARD_EVIDENCE",
      "SCHENGEN_ITINERARY_EVIDENCE",
