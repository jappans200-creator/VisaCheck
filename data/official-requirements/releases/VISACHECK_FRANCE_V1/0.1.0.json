          "role": "readiness",
          "id": "SCHENGEN_SUPPORTING_EVIDENCE",
          "revision": "0.1.0",
          "path": "data/official-requirements/document-readiness/SCHENGEN_SUPPORTING_EVIDENCE/0.1.0.json"
        }
      ]
    },
    {
      "id": "LOCAL_READINESS",
      "when": {
