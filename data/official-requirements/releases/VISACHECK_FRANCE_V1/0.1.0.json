{
  "schema_version": "1.0.0",
  "release_id": "VISACHECK_FRANCE_V1",
  "version": "0.1.0",
  "publication": {
    "status": "DEVELOPMENT_PREVIEW",
    "release_ready": false,
    "evidence_review_status": "NEEDS_REVIEW"
  },
  "applicability": {
    "all": [
      {
        "fact": "identity.nationality",
        "op": "eq",
        "value": "IN"
      },
      {
        "fact": "passport.issuing_country",
        "op": "eq",
        "value": "IN"
      },
      {
        "fact": "passport.document_type",
        "op": "eq",
        "value": "ordinary"
      },
      {
        "fact": "residence.country",
        "op": "eq",
        "value": "IE"
      },
      {
        "fact": "trip.destination_country",
        "op": "eq",
        "value": "FR"
      },
      {
        "fact": "trip.destination_territory",
        "op": "eq",
        "value": "metropolitan_france"
      },
      {
        "fact": "trip.visa_regime",
        "op": "eq",
        "value": "schengen"
      },
      {
        "fact": "trip.visa_type",
        "op": "eq",
        "value": "short_stay"
      },
      {
        "fact": "trip.purpose",
        "op": "in",
        "value": [
          "tourism",
          "private_visit"
        ]
      }
    ]
  },
  "exclude_when": {
    "any": [
      {
        "not": {
          "fact": "identity.age",
          "op": "gte",
          "value": 18
        }
      },
      {
        "not": {
          "fact": "identity.applicant_conditions",
          "op": "subset",
          "value": [
            "ordinary_adult_applicant"
          ]
        }
      },
      {
        "fact": "trip.professional_activity_planned",
        "op": "eq",
        "value": true
      },
      {
        "fact": "trip.family_settlement_planned",
        "op": "eq",
        "value": true
      },
      {
        "fact": "residence.permit_type",
        "op": "eq",
        "value": "STAMP 4 EUFAM"
      },
      {
        "fact": "context.nationality_selection",
        "op": "eq",
        "value": "OTHER"
      }
    ]
  },
  "coverage": {
    "scope": "APPLICABILITY_BOUND",
    "complete_when": {
      "all": [
        {
          "fact": "trip.purpose",
          "op": "eq",
          "value": "tourism"
        },
        {
          "fact": "identity.age",
          "op": "gte",
          "value": 18
        },
        {
          "fact": "identity.applicant_conditions",
          "op": "subset",
          "value": [
            "ordinary_adult_applicant"
          ]
        },
        {
          "fact": "residence.legal_status",
          "op": "eq",
          "value": "legal_resident"
        },
        {
          "fact": "trip.professional_activity_planned",
          "op": "eq",
          "value": false
        },
        {
          "fact": "trip.family_settlement_planned",
          "op": "eq",
          "value": false
        },
        {
          "fact": "context.single_trip",
          "op": "eq",
          "value": true
        }
      ]
    },
    "notes": "Only the ordinary tourism preview has supported runtime coverage. Private visit remains partial; research is unverified and the document list is non-exhaustive."
  },
  "evaluation_context": {
    "assessment_date": null
  },
  "groups": [
    {
      "id": "LOCAL_RULES",
      "when": {
        "fact": "context.single_trip",
        "op": "eq",
        "value": true
      },
      "assets": [
        {
          "key": "FRANCE_IE_APPLICATION_JURISDICTION",
          "role": "rule",
          "id": "FRANCE_IE_APPLICATION_JURISDICTION",
          "revision": "0.1.0",
          "path": "data/official-requirements/rules/FRANCE_IE_APPLICATION_JURISDICTION/0.1.0.json"
