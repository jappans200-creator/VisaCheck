{
  "rule_id": "SCHENGEN_EARLIEST_LODGING",
  "rule_revision": "0.1.0",
  "bundle_id": "SCHENGEN_CORE",
  "application_stage": "application_timing",
  "publication": {
    "status": "DRAFT_NOT_PUBLISHABLE",
    "release_ready": false,
    "evidence_review_status": "NEEDS_REVIEW"
  },
  "requirement": "Ordinary lodging must not be more than six calendar months before the explicitly intended visit.",
  "applicability": {
    "all": [
      {
        "fact": "trip.visa_regime",
        "op": "eq",
        "value": "schengen"
      },
      {
        "fact": "trip.visa_type",
        "op": "eq",
        "value": "short_stay"
      }
    ]
  },
  "review_gate": {
    "ordinary_condition": {
      "all": [
        {
          "fact": "passport.document_type",
          "op": "eq",
          "value": "ordinary"
        },
        {
          "fact": "identity.applicant_conditions",
          "op": "subset",
          "value": [
            "ordinary_adult_applicant"
          ]
        }
      ]
    },
    "affirmative_triggers": [],
    "reason_code": "SPECIAL_ROUTE_REQUIRES_REVIEW"
  },
  "evaluator": "relative_date_boundary",
  "parameters": {
    "actual_date": {
      "fact": "application.intended_lodging_date"
    },
    "reference_date": {
      "fact": "trip.intended_entry_date"
    },
    "amount": -6,
    "unit": "CALENDAR_MONTHS",
    "calendar_policy": "CLAMP",
    "comparison": "GTE"
  },
  "source_refs": [
    {
