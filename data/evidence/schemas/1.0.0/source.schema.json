{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Official research source revision",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "authority": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_type": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "official_status": {
      "enum": [
        "UNCONFIRMED",
        "CONFIRMED",
        "NOT_OFFICIAL"
      ]
    },
    "official_status_basis": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "consolidation_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_from": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_date_known": {
      "type": "boolean"
    },
    "effective_date_notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_copy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "type": "string",
              "format": "date-time"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "capture_method": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "path",
            "format",
            "captured_at",
            "sha256",
            "capture_method",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewer_notes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "source_revision",
    "url",
    "authority",
    "title",
    "source_type",
    "language",
    "official_status",
    "official_status_basis",
    "retrieved_at",
    "verified_at",
    "source_version",
    "consolidation_date",
    "published_at",
    "effective_from",
    "effective_to",
    "effective_date_known",
    "effective_date_notes",
    "reference_copy",
    "reviewer_notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "effective_date_known": {
            "const": true
          }
        },
        "required": [
          "effective_date_known"
        ]
      },
      "then": {
        "properties": {
          "effective_from": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effective_date_known": {
            "const": false
          }
        },
        "required": [
          "effective_date_known"
        ]
      },
      "then": {
        "properties": {
          "effective_from": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "official_status": {
            "const": "CONFIRMED"
          }
        },
        "required": [
          "official_status"
        ]
      },
      "then": {
        "properties": {
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "official_status_basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verified_at": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "official_status": {
            "const": "CONFIRMED"
          },
          "official_status_basis": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
