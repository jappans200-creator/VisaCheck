{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence pack manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "evidence_pack_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "research_profile": {
      "type": "object",
      "properties": {
        "passport_country": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "passport_document_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "residence_country": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "residence_status": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "destination_country": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination_territory": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "visa_regime": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "visa_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "applicant_conditions": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "UNDETERMINED",
                "UNRESTRICTED",
                "SPECIFIED"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "values"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "SPECIFIED"
                  }
                },
                "required": [
                  "mode"
                ]
              },
              "then": {
                "properties": {
                  "values": {
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "enum": [
                      "UNDETERMINED",
                      "UNRESTRICTED"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "values": {
                    "maxItems": 0
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "passport_country",
        "passport_document_type",
        "residence_country",
        "residence_status",
        "destination_country",
        "destination_territory",
        "visa_regime",
        "visa_type",
        "applicant_conditions"
      ],
      "additionalProperties": false
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assessment_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "research_started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "research_last_updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_policy": {
      "type": "object",
      "properties": {
        "official_sources_only": {
          "const": true
        },
        "authority_hierarchy": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "delegated_provider_scope": {
          "type": "string",
          "minLength": 1
        },
        "excluded_authority_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "conflict_handling_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "official_sources_only",
        "authority_hierarchy",
        "delegated_provider_scope",
        "excluded_authority_types",
        "conflict_handling_policy"
      ],
      "additionalProperties": false
    },
    "reviewer_status": {
      "enum": [
        "PENDING",
        "IN_REVIEW",
        "APPROVED"
      ]
    },
    "reviewer_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reviewer_id",
          "role"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "completeness_status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "READY_FOR_REVIEW",
        "COMPLETE_FOR_DECLARED_SCOPE"
      ]
    },
    "coverage_by_purpose": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "READY_FOR_REVIEW",
              "COMPLETE_FOR_DECLARED_SCOPE"
            ]
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "purpose",
          "status",
          "notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PENDING",
              "RESOLVED"
            ]
          },
          "resolution": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "question_id",
          "question",
          "blocking",
          "status",
          "resolution"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "RESOLVED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "resolution": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "source_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "revision": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
          }
        },
        "required": [
          "id",
          "revision",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_record_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "revision": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+\\.json$"
          }
        },
        "required": [
          "id",
          "revision",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "research_slot_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+\\.md#[A-Za-z0-9._-]+$"
          }
        },
        "required": [
          "slot_id",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "version",
          "changed_at",
          "actor",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "evidence_pack_id",
    "version",
    "research_profile",
    "purposes",
    "assessment_date",
    "research_started_at",
    "research_last_updated_at",
    "source_policy",
    "reviewer_status",
    "reviewer_assignments",
    "completeness_status",
    "coverage_by_purpose",
    "unresolved_questions",
    "source_references",
    "evidence_record_references",
    "research_slot_references",
    "change_history"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness_status": {
            "const": "COMPLETE_FOR_DECLARED_SCOPE"
          }
        },
        "required": [
          "completeness_status"
        ]
      },
      "then": {
        "properties": {
          "reviewer_status": {
            "const": "APPROVED"
          },
          "reviewer_assignments": {
            "minItems": 1
          },
          "assessment_date": {
            "type": "string",
            "format": "date"
          },
          "research_started_at": {
            "type": "string",
            "format": "date-time"
          },
          "research_last_updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_references": {
            "minItems": 1
          },
          "evidence_record_references": {
            "minItems": 1
          },
          "coverage_by_purpose": {
            "items": {
              "properties": {
                "status": {
                  "const": "COMPLETE_FOR_DECLARED_SCOPE"
                }
              }
            }
          },
          "unresolved_questions": {
            "items": {
              "if": {
                "properties": {
                  "blocking": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "RESOLVED"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
